            },
            "required": ["strataContract", "protocolObject", "notes"]
          }
        },
        "lossPolicy": { "type": "string", "enum": ["lossless", "explicit-loss"] },
        "extensionPoint": { "type": "boolean" }
      },
      "required": [
        "contractType",
        "apiVersion",
        "mappingId",
        "protocol",
        "protocolVersion",
        "direction",
        "contractBindings",
        "lossPolicy",
        "extensionPoint"
      ]
    },
    "RunBundle": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "contractType": { "type": "string", "const": "RunBundle" },
        "apiVersion": { "$ref": "#/$defs/ApiVersion" },
        "manifest": { "$ref": "#/$defs/ApplicationManifest" },
        "intent": { "$ref": "#/$defs/IntentEnvelope" },
        "outcome": { "$ref": "#/$defs/OutcomeContract" },
        "execution": { "$ref": "#/$defs/ExecutionEnvelope" },
        "budgetUsage": { "$ref": "#/$defs/BudgetUsage" },
        "runtimeBoundaries": {
          "type": "array",
          "items": { "$ref": "#/$defs/RuntimeBoundaryEvidence" }
        },
        "criterionResults": {
          "type": "array",
          "items": { "$ref": "#/$defs/CriterionResult" }
        },
        "authorityGrants": { "type": "array", "items": { "$ref": "#/$defs/AuthorityGrant" } },
        "approvals": { "type": "array", "items": { "$ref": "#/$defs/ApprovalReceipt" } },
        "delegations": { "type": "array", "items": { "$ref": "#/$defs/DelegationEnvelope" } },
        "capabilities": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/CapabilityContract" } },
        "decisions": { "type": "array", "items": { "$ref": "#/$defs/DecisionEvidence" } },
        "artifacts": { "type": "array", "items": { "$ref": "#/$defs/RuntimeArtifact" } },
        "attestations": { "type": "array", "items": { "$ref": "#/$defs/ArtifactAttestation" } },
        "traceEvents": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/TraceEvent" } }
      },
      "required": [
        "contractType",
        "apiVersion",
        "manifest",
        "intent",
        "outcome",
        "execution",
        "budgetUsage",
        "runtimeBoundaries",
        "criterionResults",
        "authorityGrants",
        "approvals",
        "delegations",
        "capabilities",
        "decisions",
        "artifacts",
        "attestations",
        "traceEvents"
      ]
    }
  }
